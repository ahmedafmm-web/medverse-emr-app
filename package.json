{
  "name": "medverse-emr-app",
  "version": "1.0.0",
  "homepage": "https://ahmedafmm-web.github.io/medverse-emr-app",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
